# Copy to .env.local (never commit real values) and fill in.

# Google reCAPTCHA v3 keys: https://www.google.com/recaptcha/admin (choose "Score based (v3)")
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Resend API key for sending contact form emails: https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form submissions are delivered. Server-only: never shown on the site.
CONTACT_TO_EMAIL=
# Sender shown on the email. Use an address on a domain verified in Resend, or leave
# blank to use Resend's test sender (which can only deliver to your Resend account email).
CONTACT_FROM_EMAIL=
